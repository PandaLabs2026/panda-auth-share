<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PandaAuth.Shared</RootNamespace>
    <AssemblyName>PandaAuth.Shared</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>PandaAuth.Shared</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>PandaLabs</Authors>
    <Company>PandaLabs</Company>
    <Description>Provider-neutral PandaAuth shared protocol and claims contracts.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PandaLabs2026/panda-auth-share</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PandaLabs2026/panda-auth-share.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>panda-auth;openid;oauth2;oidc;contracts</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
